# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
# SESSION_SECRET: Required in production for cryptographic HMAC-SHA256 session token signing.
# Must be a high-entropy string of at least 32 characters. Do not use default values in production.
SESSION_SECRET="your_high_entropy_session_secret_at_least_32_characters_here"

# ADMIN_AUTH_KEY: Required for secure Super Admin portal access at /admin.
# Set this to a strong, high-entropy secret in your environment or secret manager.
# If unset or missing, Admin authentication fails closed and rejects all logins.
ADMIN_AUTH_KEY="your_secure_admin_password_or_secret_here"

# Firebase Client Configuration (Vite environment variables)
VITE_FIREBASE_API_KEY="your_firebase_api_key"
VITE_FIREBASE_AUTH_DOMAIN="your_project_id.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your_project_id"
VITE_FIREBASE_STORAGE_BUCKET="your_project_id.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="your_messaging_sender_id"
VITE_FIREBASE_APP_ID="your_firebase_app_id"
VITE_FIREBASE_MEASUREMENT_ID="your_measurement_id"

